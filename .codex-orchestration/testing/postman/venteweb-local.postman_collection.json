        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"text\": \"Invite registered by email\",\n  \"firstName\": \"Registered\",\n  \"lastName\": \"User\",\n  \"email\": \"{{registeredUserEmail}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/invitations/external",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events",
            "{{eventId}}",
            "invitations",
            "external"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is expected', function () {",
              "  pm.expect([200, 201, 400, 401, 403, 404]).to.include(pm.response.code);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "if ([200, 201].includes(pm.response.code)) {",
              "  pm.test('Registered invite links to user', function () {",
              "    pm.expect(json.results.userId).to.exist;",
              "    pm.expect(json.results.externalUserId).to.not.exist;",
              "    pm.expect(json.results.invitationToken).to.exist;",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
