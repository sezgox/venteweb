{
  "info": {
    "name": "venteweb-local",
    "_postman_id": "venteweb-local-template",
    "description": "Local dev API validation flows for VenteWeb backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health - API root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login (username/email + password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is one of expected auth outcomes', function () {",
              "  pm.expect([200, 201, 400, 401]).to.include(pm.response.code);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "const token = json && json.results && json.results.access_token;",
              "if (token) pm.collectionVariables.set('accessToken', token);",
              "const userId = json && json.results && json.results.user && json.results.user.id;",
              "if (userId) pm.collectionVariables.set('organizerId', userId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Events - Create (poster optional)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const start = new Date(now.getTime() + 2 * 60 * 60 * 1000);",
              "const end = new Date(now.getTime() + 3 * 60 * 60 * 1000);",
              "pm.collectionVariables.set('eventStartDate', start.toISOString());",
              "pm.collectionVariables.set('eventEndDate', end.toISOString());",
              "pm.collectionVariables.set('eventName', `API Event ${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is expected', function () {",
              "  pm.expect([200, 201, 400, 401, 403]).to.include(pm.response.code);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "if ([200, 201].includes(pm.response.code)) {",
              "  pm.test('Event was created', function () {",
              "    pm.expect(json.results).to.exist;",
              "    pm.expect(json.results.id).to.exist;",
              "  });",
              "  pm.collectionVariables.set('eventId', json.results.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "organizerId",
              "value": "{{organizerId}}",
              "type": "text"
            },
            {
              "key": "name",
              "value": "{{eventName}}",
              "type": "text"
            },
            {
              "key": "description",
              "value": "<p>Created from Postman flow</p>",
              "type": "text"
            },
            {
              "key": "visibility",
              "value": "Public",
              "type": "text"
            },
            {
              "key": "startDate",
              "value": "{{eventStartDate}}",
              "type": "text"
            },
            {
              "key": "endDate",
              "value": "{{eventEndDate}}",
              "type": "text"
            },
            {
              "key": "location",
              "value": "C. de Emilio Castelar, 4, 28807 Alcala de Henares, Madrid, Espana",
              "type": "text"
            },
            {
              "key": "locationAlias",
              "value": "C. de Emilio Castelar, 4, 28807 Alcala de Henares, Madrid, Espana",
              "type": "text"
            },
            {
              "key": "lat",
              "value": "40.48781637671616",
              "type": "text"
            },
            {
              "key": "lng",
              "value": "-3.365213550676929",
              "type": "text"
            },
            {
              "key": "categories",
              "value": "Art",
              "type": "text"
            },
            {
              "key": "poster",
              "type": "file",
              "src": "{{eventPosterFile}}"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ]
        },
        "description": "Poster is optional. Use multipart/form-data with `poster` file only when needed."
      }
    },
