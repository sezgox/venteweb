              "pm.test('Status is expected', function () {",
              "  pm.expect([200, 201, 400, 401, 403, 404]).to.include(pm.response.code);",
              "});",
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "if ([200, 201].includes(pm.response.code)) {",
              "  pm.test('External email invite request succeeds', function () {",
              "    pm.expect(json.success).to.eql(true);",
              "  });",
              "  pm.test('External email invite links to external user', function () {",
              "    pm.expect(json.results.externalUserId).to.exist;",
              "    pm.expect(json.results.userId).to.not.exist;",
              "    pm.expect(json.results.type).to.eql('Attendance');",
              "  });",
              "  pm.test('External email invite keeps async delivery out of API contract', function () {",
              "    pm.expect(json.results.invitationToken).to.be.a('string');",
              "  });",
              "  pm.collectionVariables.set('externalUserEmailId', json.results.externalUserId);",
              "  pm.collectionVariables.set('invitationId', json.results.id);",
              "  pm.collectionVariables.set('invitationToken', json.results.invitationToken);",
              "}"
            ]
          }
        }
