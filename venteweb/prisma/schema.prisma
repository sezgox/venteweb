// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ========================================
// ENUMS
// ========================================

enum Permission {
  Standard
  Premium
}

enum Level {
  New
  Active
  Featured
  Influencer
}

enum Visibility {
  Public
  Private
}

enum Category {
  Sports
  Tournament
  Educational
  Pets
  Gaming
  Political
  Food
  Party
  Music
  Meetup
  Art
  Conference
  Workshop
  Competition
}

enum ParticipationType {
  Volunteer
  Attendance
}

enum EventMode {
  OnSite
  Virtual
}

enum NotificationType {
  Post
  Reminder
  RequestCollaboration // Notificacion al organizador
  RequestAnswered      // Notificacion al usuario que hizo la solicitud (caso Reject/Accept pero no Canceled)
  Participation        // Notificacion al organizador
  Rating
  Invitation          // Notificacion al usuario invitado
  InvitationAnswered  // Notificacion al organizador  (caso Reject/Accept pero no Canceled)
  Follow
}

enum Emoji {
  SMILE
  LAUGH
  HEART
  THUMBS_UP
  FIRE
  STAR
}

// ========================================
// MODELS
// ========================================

model User {
  id                String           @id @default(cuid())
  permission        Permission       @default(Standard)
  level             Level            @default(New)
  username          String           @unique
  name              String
  password          String?
  email             String           @unique
  photo             String?
  active            Boolean          @default(true)
  activatedAt       DateTime?
  firebaseUid       String?          @unique
  emailSent         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastLogin         DateTime?
  bio               String?
  locale            String?
  refreshToken      String?

  // Relations
  events            Event[]          @relation("UserEvents")
  requests          Request[]
  participations    Participation[]
  interactions      Interaction[]
  invitations       Invitation[]
  posts             Post[]
  followers         Follow[]         @relation("UserFollowers")
  following         Follow[]         @relation("UserFollowing")
  notifications   Notification[]
  activationTokens ActivationToken[]
  ratings          Rating[]

}

model ActivationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========================================
// EVENT
// ========================================

model Event {
  id                String           @id
  organizerId       String
  poster            String?
  name              String
  categories        Category[]
  description       String
  visibility        Visibility
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  canceledAt        DateTime?
  tags              String[]
  language          String?
  allowPosts        Boolean          @default(false)
  onlyVirtual       Boolean          @default(false)

  // Relations
  organizer           User             @relation("UserEvents", fields: [organizerId], references: [id])
  participations    Participation[]
  requests          Request[]
  invitations       Invitation[]
  posts             Post[]
  sections          Section[]
  ratings           Rating[]
  onSiteEvent       OnSiteEvent?
  virtualEvent      VirtualEvent?
}

model OnSiteEvent {
  eventId            String       @id
  maxAttendees       Int?
  maxCollaborators   Int?
  lat                Float
  lng                Float
  location           String
  locationAlias      String?
  startDate          DateTime
  endDate            DateTime
  requiresRequest    Boolean      @default(false)
  invitation         String?
  totalRate          Float?
  ratingCount        Int          @default(0)

  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requests           Request[]    @relation("OnSiteEventRequests")
  invitations        Invitation[] @relation("OnSiteEventInvitations")
  ratings            Rating[]     @relation("OnSiteEventRatings")
}

model VirtualEvent {
  eventId            String       @id
  maxAttendees       Int?
  maxCollaborators   Int?
  requiresRequest    Boolean      @default(false)
  invitation         String?
  totalRate          Float?
  ratingCount        Int          @default(0)
  startDate          DateTime
  endDate            DateTime

  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platforms          Platform[]
  requests           Request[]    @relation("VirtualEventRequests")
  invitations        Invitation[] @relation("VirtualEventInvitations")
  ratings            Rating[]     @relation("VirtualEventRatings")
}

model Platform {
  id                 String       @id @default(cuid())
  virtualEventId     String
  name               String
  link               String

  virtualEvent       VirtualEvent @relation(fields: [virtualEventId], references: [eventId], onDelete: Cascade)

  @@index([virtualEventId])
}

// ========================================
// SECTION
// ========================================

model Section {
  id                String     @id @default(cuid())
  eventId           String
  startDate         DateTime
  endDate           DateTime
  description       String
  title             String
  location          String  
  locationAlias     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  event             Event      @relation(fields: [eventId], references: [id])
}

// ========================================
// POST
// ========================================

model Post {
  id                    String         @id @default(cuid())
  userId                String
  eventId               String
  text                  String
  images                String[]
  referencePostId       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id])
  event                 Event          @relation(fields: [eventId], references: [id])
  interactions          Interaction[]
  referencePost         Post?          @relation("PostReference", fields: [referencePostId], references: [id])
  referencedBy          Post[]         @relation("PostReference")
}

// ========================================
// INTERACTION
// ========================================

model Interaction {
  userId        String
  postId        String
  emoji         Emoji
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
  post          Post     @relation(fields: [postId], references: [id])

  @@id([userId, postId])
}

// ========================================
// PARTICIPATION
// ========================================

model Participation {
  id              String    @id @default(cuid())
  userId          String?
  externalUserId  String?
  eventId         String
  eventMode       EventMode @default(OnSite)
  type            ParticipationType
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invitation      String?

  user            User?      @relation(fields: [userId], references: [id])
  externalUser    ExternalUser? @relation(fields: [externalUserId], references: [id])
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating          Rating?

  @@unique([userId, eventId, eventMode])
  @@unique([externalUserId, eventId, eventMode])
  @@index([eventId, eventMode])
}

// ========================================
// RATING
// ========================================

model Rating {
  id              String    @id @default(cuid())
  userId          String
  eventId         String
  eventMode       EventMode @default(OnSite)
  onSiteEventId   String?
  virtualEventId  String?
  participationId String    @unique
  text            String?
  score           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation   Participation @relation(fields: [participationId], references: [id])
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])
  onSiteEvent     OnSiteEvent?  @relation("OnSiteEventRatings", fields: [onSiteEventId], references: [eventId], onDelete: Cascade)
  virtualEvent    VirtualEvent? @relation("VirtualEventRatings", fields: [virtualEventId], references: [eventId], onDelete: Cascade)

  @@unique([userId, eventId, eventMode])
  @@index([eventId, eventMode])
  @@index([eventId, eventMode, updatedAt])
}


// ========================================
// REQUEST
// ========================================

model Request {
  id              String           @id @default(cuid())
  text            String
  userId          String?
  eventId         String
  eventMode       EventMode        @default(OnSite)
  onSiteEventId   String?
  virtualEventId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User?             @relation(fields: [userId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  onSiteEvent     OnSiteEvent?     @relation("OnSiteEventRequests", fields: [onSiteEventId], references: [eventId], onDelete: Cascade)
  virtualEvent    VirtualEvent?    @relation("VirtualEventRequests", fields: [virtualEventId], references: [eventId], onDelete: Cascade)
}

// ========================================
// INVITATION
// ========================================

model Invitation {
  id              String           @id @default(cuid())
  text            String
  userId          String?
  externalUserId  String?
  eventId         String
  eventMode       EventMode        @default(OnSite)
  onSiteEventId   String?
  virtualEventId  String?
  invitationToken String
  type            ParticipationType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User?            @relation(fields: [userId], references: [id])
  externalUser    ExternalUser?    @relation(fields: [externalUserId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  onSiteEvent     OnSiteEvent?     @relation("OnSiteEventInvitations", fields: [onSiteEventId], references: [eventId], onDelete: Cascade)
  virtualEvent    VirtualEvent?    @relation("VirtualEventInvitations", fields: [virtualEventId], references: [eventId], onDelete: Cascade)
}

model ExternalUser {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  invitations     Invitation[]
  participations  Participation[]

  @@index([email])
  @@index([phone])
}

// ========================================
// FOLLOW
// ========================================

model Follow {
  followerId  String
  followedId  String
  follower    User    @relation("UserFollowing", fields: [followerId], references: [id])
  followed    User    @relation("UserFollowers", fields: [followedId], references: [id])

  @@id([followerId, followedId])
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String?
  relatedId   String?
  createdAt   DateTime          @default(now())
  read        Boolean           @default(false)

  user        User              @relation(fields: [userId], references: [id])
}
